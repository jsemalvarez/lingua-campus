# Lingua Campus — variables de entorno
#
# Copiar a `.env` y completar. Este archivo se versiona: **nunca poner valores
# reales acá**, sólo el formato y para qué sirve cada una.
#
# Al agregar una variable nueva al código, agregarla también acá. Es la única
# lista completa que existe: `grep process.env` no alcanza, porque hay accesos
# dinámicos (`process.env[name]` en `src/lib/practice/quota.ts`) y porque Prisma
# lee las suyas desde `prisma/schema.prisma`, no desde el código.


# ─── Base de datos ───────────────────────────────────────────────────────────
# Las lee `prisma/schema.prisma`.
#
# En Supabase son dos URLs distintas y no son intercambiables: `DATABASE_URL` va
# por el pooler (pgbouncer, puerto 6543) y la usa la app; `DIRECT_URL` va directo
# al puerto 5432 y la usan las migraciones, que necesitan una conexión de sesión.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"


# ─── Postgres local (docker-compose.yml) ─────────────────────────────────────
# Sólo para levantar la base de desarrollo con `docker compose up`. En Vercel no
# van. Si se usan, `DATABASE_URL` apunta a este contenedor.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lingua_campus_dev


# ─── Autenticación (NextAuth) ────────────────────────────────────────────────
# `NEXTAUTH_SECRET` firma los JWT de sesión. Generar uno propio por entorno:
#   openssl rand -base64 32
# Cambiarlo invalida todas las sesiones abiertas.
NEXTAUTH_SECRET=
# URL pública del entorno, sin barra final. En local: http://localhost:3000
NEXTAUTH_URL="https://tu-entorno.vercel.app"


# ─── Supabase Storage ────────────────────────────────────────────────────────
# Las `NEXT_PUBLIC_*` viajan al navegador: ahí sólo puede ir la anon key.
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La service role key saltea las políticas de RLS. Sólo servidor, nunca con
# prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Módulo de práctica · IA ─────────────────────────────────────────────────
# Proveedor de texto: "gemini" | "openai". Sólo hace falta la key del que se use.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Proveedor de voz: "browser" | "openai" | "elevenlabs".
# "browser" sintetiza en el cliente con speechSynthesis: no cuesta nada, no pide
# key y no descuenta cuota de IA. Los otros dos generan el audio en el servidor.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=


# ─── Módulo de práctica · límite de uso (SEC-07) ─────────────────────────────
# Opcionales: si no están, valen los defaults de `src/lib/practice/quota.ts`.
#
# El tope por usuario corta el abuso automatizado; el del instituto es el que
# mira la factura. Ojo con este último: el free tier de Gemini son 1500 requests
# diarias para *todo* el proyecto, compartidas entre todos los institutos.
# AI_LIMIT_USER_HOURLY=150
# AI_LIMIT_INSTITUTE_DAILY=1200


# ─── Seed (prisma/seed.js) ───────────────────────────────────────────────────
# Credenciales del superadmin que crea el seed. Sólo para desarrollo.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

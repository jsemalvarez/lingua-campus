// This is your Prisma schema file for Lingua Campus.
// It uses PostgreSQL for persistence and is designed for Multi-tenancy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// CORE TENANCY
enum InstitutePlan {
  BASIC
  STANDARD
  PREMIUM
}

model Institute {
  id          String   @id @default(cuid())
  name        String
  subdomain   String   @unique
  customDomain String? @unique
  plan        InstitutePlan @default(BASIC)
  address     String?
  phone       String?
  email       String?
  description String?
  logoUrl     String?
  facebookUrl String?
  instagramUrl String?
  whatsappNumber String?
  pwaIcon192 String?
  pwaIcon512 String?
  cuit        String?
  grossIncome String?
  activityStartDate DateTime?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users         User[]
  students      Student[]
  courses       Course[]
  miscellaneousIncome MiscellaneousIncome[]
  expenses      Expense[]
  classrooms    Classroom[]
  levels        Level[]
  notifications Notification[]
  reportTemplates ReportTemplate[]
  signatures    Signature[]
  signatureReferences SignatureReference[]
}

// -----------------------------------------------------------------------------
// USERS & AUTH
// -----------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN // All access (L-C devs)
  ADMIN      // Institute owner/admin
  TEACHER    // Staff member
  SECRETARY  // Administrative staff
  GUARDIAN   // Parent / Guardian
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  roles       UserRole[] @default([ADMIN])
  dni         String?    @unique
  name        String     // Nombre Completo
  phone       String?    // Celular
  avatarUrl   String?
  status      String   @default("ACTIVE") // ACTIVE, DELETED
  preferences Json?      // Almacena preferencias visuales como ordenamiento de cursos
  
  hourlyRate  Float?   @default(0)
  
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id])
  
  courses     Course[]   @relation("CourseTeacher")
  expensesReceived Expense[]  @relation("RecipientExpenses")
  
  // Relation for Guardian Portal
  guardianLinks GuardianStudentLink[] @relation("GuardianToStudent")
  
  notifications Notification[]

  // Messaging
  threadParticipations ThreadParticipant[]
  sentMessages         Message[]           @relation("UserSentMessages")

  // Firmas de conformidad (FEAT-09)
  signatureReference SignatureReference?
  signatures         Signature[]
  mustSign           ReportSigner[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// BOARD: STUDENTS & ENROLLMENTS
// -----------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  name          String
  email         String?  
  password      String?
  phone         String?
  address       String?
  dni           String?
  schoolInfo    String?
  registeredLevel String?
  status          String   @default("ACTIVE") // ACTIVE, DELETED
  
  // Tutor Legal 1
  guardian1Name     String?
  guardian1Relation String?
  guardian1Phone    String?
  guardian1Email    String?
  
  // Tutor Legal 2
  guardian2Name     String?
  guardian2Relation String?
  guardian2Phone    String?
  guardian2Email    String?
  birthDate     DateTime?
  joinDate      DateTime @default(now())

  // Billetera Virtual (Saldos a favor)
  creditBalance Float    @default(0)
  
  instituteId   String
  institute     Institute @relation(fields: [instituteId], references: [id])
  
  enrollments   Enrollment[]
  attendances   Attendance[]
  grades        Grade[]
  fees          Fee[]
  miscellaneousIncome MiscellaneousIncome[]
  practiceSessions PracticeSession[]
  
  // Relation for Guardian Portal
  guardianLinks GuardianStudentLink[] @relation("StudentToGuardian")

  // Relation for data completion tokens
  dataTokens    StudentDataToken[]
  
  notifications Notification[]
  studentReports StudentReport[]

  // Messaging
  threadParticipations ThreadParticipant[]
  sentMessages         Message[]           @relation("StudentSentMessages")

  // Firmas de conformidad (FEAT-09) — el alumno de 20+ firma su propio informe
  signatureReference SignatureReference?
  signatures         Signature[]
  mustSign           ReportSigner[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email, instituteId])
  @@unique([dni, instituteId])
}

model GuardianStudentLink {
  id          String   @id @default(cuid())
  guardianId  String
  guardian    User     @relation("GuardianToStudent", fields: [guardianId], references: [id])
  studentId   String
  student     Student  @relation("StudentToGuardian", fields: [studentId], references: [id])
  relation    String?  // Madre, Padre, Tío, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guardianId, studentId])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  level       String?
  color       String   @default("#3b82f6") // Default blue-500
  status      String   @default("ACTIVE") // ACTIVE, FINISHED
  
  teacherId   String?
  teacher     User?     @relation("CourseTeacher", fields: [teacherId], references: [id])
  
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  enrollments Enrollment[]
  schedules   Schedule[]
  lessons     Lesson[]
  threads     MessageThread[]
  reportTemplates CourseReportTemplate[]
  studentReports  StudentReport[]


  startDate   DateTime?
  endDate     DateTime?

  // Financials
  monthlyPrice   Float @default(0)
  enrollmentPrice Float @default(0)
  examPrice      Float @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BillingMode {
  MONTHLY
  FULL_COURSE
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  enrolledAt  DateTime @default(now())
  status      String   @default("ACTIVE") // ACTIVE, FINISHED, INCOMPLETE

  // Billing & Custom Pricing (Scholarships / Upfront)
  billingMode           BillingMode @default(MONTHLY)
  customMonthlyPrice    Float?
  customEnrollmentPrice Float?
  customExamPrice       Float?
  customFullCoursePrice Float?

  takesExam   Boolean  @default(false)

  fees        Fee[]

  @@unique([studentId, courseId])
}

// -----------------------------------------------------------------------------
// ATTENDANCE & ACADEMICS
// -----------------------------------------------------------------------------

model Schedule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  dayOfWeek   Int      // 0-6 (Sun-Sat)
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  room        String?  // Ej: "Aula 1", "Laboratorio", etc

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
}

model Classroom {
  id          String    @id @default(cuid())
  name        String
  capacity    Int?
  
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  courses     Course[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, instituteId])
}

model Level {
  id          String    @id @default(cuid())
  name        String
  
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, instituteId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

// De dónde salió la marca (FEAT-11).
//
// Antes esto se deducía de un texto en `notes` que el propio escáner escribía, y
// eso rompía dos cosas a la vez: le pisaba la observación a la docente (BUG-12) y
// no aguantaba como fuente de una métrica, porque el campo es libre y editable.
enum AttendanceSource {
  MANUAL
  QR
}

enum LessonType {
  CLASS
  TP
  EXAM
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  type        LessonType @default(CLASS)
  status      String   @default("ACTIVE") // ACTIVE, DELETED

  date        DateTime @db.Date
  topic       String
  content     String?  @db.Text
  
  attendances Attendance[]
  grades      Grade[]
  practice    LessonPractice?
  practiceSessions PracticeSession[]

  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])

  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, status])
}

// -----------------------------------------------------------------------------
// PRACTICE MODULE
// -----------------------------------------------------------------------------

enum PracticeType {
  SPEAKING
  LISTENING
  CHAT
}

// Material cargado por el profesor para que el alumno practique lo visto en clase
model LessonPractice {
  id               String   @id @default(cuid())
  lessonId         String   @unique
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Contenido de práctica cargado por el profesor
  speakingPhrases  String[] // Frases base para pronunciación, una por elemento
  listeningText    String?  @db.Text // Texto que se convierte a audio TTS
  chatScenario     String?  @db.Text // Escenario para el AI Chatbot

  isPublished      Boolean  @default(false) // El profesor activa cuando está listo

  sessions         PracticeSession[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lessonId])
}

// Registro de cada sesión de práctica completada por un alumno
model PracticeSession {
  id                 String         @id @default(cuid())

  studentId          String
  student            Student        @relation(fields: [studentId], references: [id])

  lessonId           String
  lesson             Lesson         @relation(fields: [lessonId], references: [id])

  lessonPracticeId   String
  lessonPractice     LessonPractice @relation(fields: [lessonPracticeId], references: [id])

  type               PracticeType

  // Métricas de precisión (Speaking + Listening)
  phrasesAttempted   Int    @default(0)
  phrasesCorrect     Int    @default(0)
  accuracyPct        Float  @default(0) // 0-100, calculado al cerrar la sesión

  // Área de dificultad detectada por la IA durante la sesión
  weakArea           String? // Ej: "th fricative", "short vowels"

  durationSeconds    Int    @default(0)
  completedAt        DateTime @default(now())

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

// Consumo de los proveedores de IA, para el límite de uso de SEC-07.
//
// No hay relación con `User`/`Student`/`Institute` a propósito: la fila es un
// contador, no un dato del negocio, y borrar el sujeto no tiene por qué fallar
// ni arrastrar historial. Por eso `subjectId` es un id suelto.
//
// El período no es fijo: el usuario se cuenta por hora y el instituto por día
// (ver `src/lib/practice/quota.ts`). Guardar el inicio de la ventana en vez del
// tipo de período deja el mismo contador para las dos escalas, y es lo que va a
// necesitar PED-07 cuando el tope dependa del plan.
model AiUsage {
  id          String   @id @default(cuid())

  subjectType String   // "USER" | "INSTITUTE"
  subjectId   String
  windowStart DateTime // Inicio de la ventana, en UTC

  count       Int      @default(0)

  @@unique([subjectType, subjectId, windowStart])
  @@index([windowStart])
}

// Actividad diaria de cada persona, para el panel de uso (FEAT-11).
//
// **Una fila por persona y por día, no por evento.** Acota el crecimiento sin
// depender de con qué frecuencia se escriba, y por eso no obliga a decidir la
// retención antes de empezar a guardar. Cota con los números de hoy: 580
// personas × 200 días lectivos ≈ 116.000 filas al año, y eso suponiendo que
// entren todas todos los días.
//
// Sigue la forma de `AiUsage` —un contador con `subjectId` suelto, sin relación
// con `User`/`Student`—, así que borrar a la persona no falla ni arrastra
// historial, y la tabla **no se suma a la lista de ARQ-15**.
//
// A diferencia de `AiUsage`, sí guarda `instituteId`: es el hueco que PED-10 le
// encontró a esa tabla, que no puede agregar sus filas de usuario por instituto.
// Es nulo sólo para el SUPERADMIN, que no tiene instituto.
//
// **No se guardan ni IP ni dispositivo**, alineado con FEAT-04.
model ActivityDay {
  subjectType String   // "USER" | "STUDENT"
  subjectId   String
  instituteId String?
  day         DateTime @db.Date

  // Los roles que la persona tenía ese día. Desde SEC-01 una misma persona
  // puede ser tutora y profesora: se guardan todos y el panel decide cómo
  // agrupar, en vez de elegir uno acá y perder la otra mitad.
  roles       String[]

  // Veces que tipeó la contraseña. No es lo mismo que uso: el JWT dura 30 días,
  // así que alguien que entra todos los días puede tener un solo login al mes.
  // Lo que mide uso es `lastSeenAt`.
  logins      Int      @default(0)

  // Secciones del portal del tutor abiertas ese día. Es lo único que contesta
  // "¿miran las asistencias y las notas?": leer una pantalla no deja ningún otro
  // rastro en la base.
  sections    String[]

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@id([subjectType, subjectId, day])
  @@index([instituteId, day])
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  status      AttendanceStatus
  notes       String?

  // Si el escáner intervino en esta marca. Lo escribe sólo el kiosco, y el
  // parte de la docente **no lo pisa**: una vez que hubo escaneo, la fila queda
  // en `QR` aunque después se corrija el estado. Es el mismo criterio con el que
  // `createdAt` sobrevive al regrabado, y es lo que hace que la métrica conteste
  // "¿se usa el escáner?" en vez de "¿quién guardó último?".
  source      AttendanceSource @default(MANUAL)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, lessonId])
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  score       String?  // Can be a number like "8.5" or a letter like "A+"
  feedback    String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([studentId, lessonId])
}

// -----------------------------------------------------------------------------
// FINANCIALS
// -----------------------------------------------------------------------------

enum TransactionType {
  PAYMENT        // Ingreso por Cuota/Matrícula
  EXPENSE        // Gasto común
  PAYROLL        // Pago de sueldo
  REFUND         // Devolución a un alumno
  MISC_INCOME    // Otros ingresos (libros, excursiones)
  ADJUSTMENT     // Ajustes de balance
}

enum TransactionStatus {
  VALID
  VOIDED     // Anulado por error humano
}

model Transaction {
  id          String   @id @default(cuid())
  instituteId String
  amount      Float    // Positivo para ingresos, Negativo para salidas
  type        TransactionType
  method      String   // EFECTIVO, TRANSFERENCIA, etc.
  date        DateTime @default(now())
  status      TransactionStatus @default(VALID)
  
  description String?  // Concepto

  // Enlaces a la entidad original (sólo uno tendrá valor)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id])
  
  miscIncomeId String?
  miscIncome   MiscellaneousIncome? @relation(fields: [miscIncomeId], references: [id])

  operatorId  String?  // Id del usuario que registró el movimiento (opcional)
  
  createdAt   DateTime @default(now())
  
  @@index([instituteId])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum FeeType {
  MONTHLY
  ENROLLMENT
  EXAM
  FULL_COURSE
}

model Fee {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  enrollmentId String?
  // `Restrict` y no el `SetNull` que Prisma pone por defecto en una relación
  // opcional: con aquel, borrar una inscripción le sacaba el curso a todas sus
  // cuotas —las pagas incluidas— sin avisar, y la cuota quedaba sin dueño. Ver
  // FIN-23. La regla que impone acá es la que queremos: una inscripción con
  // cuotas emitidas no se borra, se marca.
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  type        FeeType @default(MONTHLY)
  
  originalAmount Float    // Precio base al momento de generar (Snapshot)
  paidAmount     Float    @default(0) // Suma de todos los pagos realizados
  
  year        Int
  month       Int      // 1-12. Las matrículas y los derechos de examen van siempre
                       // en 0: son anuales y el mes no significa nada
                       // (ENROLLMENT_FEE_MONTH en FIN-12, EXAM_FEE_MONTH en FIN-17).
  status      PaymentStatus @default(PENDING)
  datePaid    DateTime?
  
  instituteId String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]

  // Una cuota por inscripción, tipo y período. Antes la regla vivía sólo en
  // memoria ("consultar existentes → filtrar → crear"), así que dos clics
  // seguidos generaban la cuota dos veces. Ver FIN-06.
  //
  // Para las matrículas significa "una por inscripción y año", porque van todas
  // con el mismo `month` (FIN-12). Antes llevaban el mes de creación y dos
  // generaciones en meses distintos pasaban de largo. Lo mismo vale desde FIN-17
  // para los derechos de examen, que arrastraban ese mismo mes administrativo y
  // por eso quedaban fuera de la regla.
  //
  // Lo único que sigue afuera es la matrícula anticipada, que se crea sin
  // `enrollmentId` y en Postgres los NULL no chocan entre sí. Ahí la regla la
  // hace cumplir `generateStandaloneEnrollmentFeeAction` en memoria.
  @@unique([enrollmentId, type, year, month])
}

// La foto de una cuota borrada. Ver FEAT-10.
//
// `deleteFeeAction` borra la fila de `Fee` físicamente —es la única acción de
// plata que lo hace, y sólo sobre deuda impaga—, así que cuando esto se escribe
// la cuota ya no existe: no hay a qué apuntar, hay que copiar. Por eso el alumno
// va con su id y con su nombre, y por eso no hay ninguna clave foránea: la fila
// tiene que sobrevivir a que después se borre lo que nombra.
//
// No es una fila del libro mayor. Una deuda borrada no movió dinero, y de hecho
// el rodeo anterior —un asiento de importe 0 en `Transaction`— quedaba invisible
// en la tabla de `/payments`, que filtra los movimientos en cero (FIN-11), y no
// tenía dónde guardar el motivo.
model FeeDeletion {
  id          String   @id @default(cuid())
  instituteId String

  // Datos del alumno al momento de borrar. El id sirve para llegar a la ficha;
  // el nombre, para que la pantalla siga diciendo algo si al alumno lo purgan.
  studentId   String
  studentName String

  // La cuota que ya no está.
  type        FeeType
  year        Int
  month       Int
  amount      Float    // `originalAmount` de la cuota borrada
  courseName  String?  // Sólo si la cuota estaba vinculada a una inscripción

  // Obligatorio, y es más exigente que el motivo de las anulaciones —que es
  // opcional— a propósito: acá no queda la fila original para mirar.
  reason      String

  deletedById String
  deletedAt   DateTime @default(now())

  // Es como lo lista la pantalla: el instituto, lo último arriba.
  @@index([instituteId, deletedAt])
}

model Payment {
  id          String   @id @default(cuid())
  feeId       String
  fee         Fee      @relation(fields: [feeId], references: [id])
  
  amount      Float
  surcharge   Float    @default(0)
  discount    Float    @default(0)
  method      String   // EFECTIVO, TRANSFERENCIA, etc.
  date        DateTime @default(now())
  notes       String?
  status      TransactionStatus @default(VALID)
  
  transactions Transaction[]
  
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime @db.Date
  category    String   // Payroll, Rent, Utilities, etc.
  ticketNumber String?
  status      TransactionStatus @default(VALID)
  
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  recipientId String?
  recipient   User?     @relation("RecipientExpenses", fields: [recipientId], references: [id])

  lessons     Lesson[]
  transactions Transaction[]

  createdAt   DateTime @default(now())

  @@index([recipientId])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------------

model Notification {
  id          String   @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  type        String   // "NEW_ENROLLMENT", "PAYMENT_RECEIVED", etc.
  title       String
  body        String
  read        Boolean  @default(false)
  link        String?  // URL a donde navegar al hacer clic

  createdAt   DateTime @default(now())

  @@index([instituteId, read])
  @@index([userId, read])
  @@index([studentId, read])
}

model MiscellaneousIncome {
  id           String    @id @default(cuid())
  description  String
  amount       Float
  date         DateTime  @db.Date
  category     String    // VENTA_LIBROS, EXCURSION, TALLER, OTROS
  method       String    // EFECTIVO, TRANSFERENCIA, etc.
  ticketNumber String?
  status       TransactionStatus @default(VALID)
  
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id])
  
  studentId    String?   // Opcional
  student      Student?  @relation(fields: [studentId], references: [id])

  transactions Transaction[]

  createdAt    DateTime  @default(now())

  @@index([instituteId])
  @@index([studentId])
}

// -----------------------------------------------------------------------------
// STUDENT DATA COMPLETION TOKENS
// -----------------------------------------------------------------------------

model StudentDataToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// MESSAGING
// -----------------------------------------------------------------------------

enum ThreadType {
  DIRECT        // Dirigido a persona(s) específica(s)
  COURSE_BLAST  // Dirigido a todos los alumnos/tutores de un curso
}

// Hilo de conversación (agrupa mensajes bajo un asunto)
model MessageThread {
  id          String     @id @default(cuid())
  instituteId String

  subject     String     // Asunto — siempre requerido (estilo email)
  type        ThreadType @default(DIRECT)

  // Contexto opcional: si el hilo está relacionado a un curso específico
  courseId    String?
  course      Course?    @relation(fields: [courseId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  participants ThreadParticipant[]
  messages     Message[]

  @@index([instituteId])
  @@index([instituteId, updatedAt])
}

// Participantes del hilo (polimórfico: User o Student)
model ThreadParticipant {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Exactamente uno de los dos debe estar poblado
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  isAuthor   Boolean  @default(false)   // true = quien inició el hilo
  lastReadAt DateTime?                   // Para calcular mensajes no leídos
  actingRole String?                     // El rol activo que tenía al crear/unirse al hilo (ej: "ADMIN", "TEACHER")

  createdAt  DateTime @default(now())

  @@unique([threadId, userId])
  @@unique([threadId, studentId])
  @@index([userId])
  @@index([studentId])
}

// Mensaje individual dentro de un hilo
model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Polimórfico: o un User (teacher, admin, guardian) o un Student
  senderUserId    String?
  senderUser      User?    @relation("UserSentMessages", fields: [senderUserId], references: [id])

  senderStudentId String?
  senderStudent   Student? @relation("StudentSentMessages", fields: [senderStudentId], references: [id])

  senderRole      String?  // El rol activo al enviar este mensaje (ej: "ADMIN", "TEACHER")

  body      String   @db.Text

  // File attachment (optional — max 1 per message)
  attachmentPath  String?  // Path in Supabase Storage: "{instituteId}/{threadId}/{ts}-{id}.{ext}"
  attachmentName  String?  // Original filename (e.g. "tarea-junio.pdf")
  attachmentMime  String?  // MIME type (e.g. "application/pdf")
  attachmentSize  Int?     // Size in bytes

  // Shared link (optional — mutually exclusive with file attachment)
  sharedUrl       String?  // Full URL (e.g. "https://drive.google.com/...")
  sharedUrlTitle  String?  // og:title
  sharedUrlDesc   String?  // og:description
  sharedUrlImage  String?  // og:image

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

// -----------------------------------------------------------------------------
// REPORTING & TEMPLATES SYSTEM
// -----------------------------------------------------------------------------

model ReportTemplate {
  id            String   @id @default(cuid())
  instituteId   String
  institute     Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name          String   // "Boletín Trimestral Inglés", "Informe Mensual Niños"
  isActive      Boolean  @default(true)

  // Períodos
  periodType    String   // MONTHLY | BIMONTHLY | QUARTERLY | CUSTOM
  periodCount   Int      // Cantidad de períodos (ej: 3, 6, 12)
  periodLabels  String[] // Etiquetas: ["1° Trimestre", "2° Trimestre", ...]

  // Campos especiales guardados como JSON (comentarios, firmas de tutor, alumno, prof)
  specialFields Json     // { teacherComments: boolean, teacherSignature: boolean, parentSignature: boolean, studentSignature: boolean }

  categories    ReportCategory[]
  reports       StudentReport[]
  courses       CourseReportTemplate[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, instituteId])
}

model ReportCategory {
  id            String         @id @default(cuid())
  templateId    String
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name          String         // Ej: "Oral Work", "Attitude", etc.
  order         Int            // Para ordenar las columnas/filas
  scaleType     String         // NUMERIC | CONCEPTUAL | LETTER | CUSTOM
  scaleOptions  Json           // Opciones guardadas como JSON: [{"label": "Excelente", "value": "E"}, ...]
  scaleMin      Float?         // Para escalas numéricas: valor mínimo
  scaleMax      Float?         // Para escalas numéricas: valor máximo

  entries       ReportEntry[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([templateId, order])
}

model CourseReportTemplate {
  id            String         @id @default(cuid())
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  templateId    String
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  isActive      Boolean        @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([courseId, templateId])
}

model StudentReport {
  id              String         @id @default(cuid())
  templateId      String
  template        ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  year            Int            // Año lectivo (ej: 2026)
  periodIndex     Int            // Índice del período (0-based)
  teacherComments String?        @db.Text
  publishedAt     DateTime?      // null = Borrador | Fecha = Publicado

  // Hash del contenido actual. Si no coincide con el de una firma, el informe
  // se tocó después de que esa persona lo firmó (FEAT-09).
  contentHash     String?
  lastEditedAt    DateTime?      // Última edición posterior a la publicación
  lastEditedById  String?        // Id del ADMIN que la hizo (sin FK, como operatorId)

  // El instituto registra que el informe llegó por fuera de la plataforma,
  // para la familia que no va a entrar nunca. No es una firma.
  deliveredOtherAt   DateTime?
  deliveredOtherById String?
  deliveredOtherNote String?

  entries         ReportEntry[]
  signers         ReportSigner[]
  signatures      Signature[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([studentId, courseId, year, periodIndex, templateId])
  @@index([courseId, year, periodIndex])
}

model ReportEntry {
  id            String         @id @default(cuid())
  reportId      String
  report        StudentReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  categoryId    String
  category      ReportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  value         String?        // Guardamos el valor como string ("8.5", "E", "A-", etc.)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([reportId, categoryId])
}

// -----------------------------------------------------------------------------
// FIRMAS DE CONFORMIDAD (FEAT-09)
// Es un acuse de lectura con conformidad explícita, no una firma digital de la
// Ley 25.506. Sirve para que el instituto sepa quién vio las notas.
// -----------------------------------------------------------------------------

// La firma de referencia de una persona, contra la que se comparan las que
// siguen. No hay paso de enrolamiento: se registra sola con la primera firma, y
// la persona la puede volver a registrar desde su propio perfil. Una por
// persona, no por alumno: un tutor con tres hijos registra una sola.
model SignatureReference {
  id          String   @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  // Polimórfico: o un User (tutor) o un Student (el alumno de 20+ que firma solo)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId   String?  @unique
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Secuencia de puntos con tiempos, no una imagen: la dinámica del trazo es lo
  // que sirve para comparar. Se vacía al soltar el vínculo con el instituto.
  strokeData  Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A quién le toca firmar un informe. Se resuelve y se CONGELA al publicarlo:
// nunca se recalcula, para que cumplir años o sumar un tutor no le cambie el
// estado a un informe ya publicado. Cero filas = "sin firmante".
model ReportSigner {
  id        String        @id @default(cuid())
  reportId  String
  report    StudentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@unique([reportId, studentId])
  @@index([reportId])
}

// Un acto de firma. Alcanza con una para dar el informe por firmado.
model Signature {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  // El documento firmado. Hoy sólo informes; una novedad suma otra columna
  // opcional, en vez de un par tipo+id que perdería la integridad referencial
  // que ARQ-01 ya viene reclamando.
  reportId    String?
  report      StudentReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id])

  signedAt    DateTime  @default(now())

  // Hash del contenido exacto que se firmó. Si deja de coincidir con el del
  // informe, alguien lo editó después y hay que mostrarlo así.
  contentHash String

  // El trazo de esta firma. Se vacía por retención; la fila queda siempre.
  strokeData  Json?

  // Parecido contra la referencia, de 0 a 100. Se guarda desde el día uno y no
  // se muestra hasta calibrar el umbral con firmas reales. Nunca bloquea.
  similarityScore Float?

  @@index([reportId])
  @@index([instituteId, signedAt])
}

